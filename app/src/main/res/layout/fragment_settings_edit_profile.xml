<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey"
    tools:context=".SettingsEditProfileFragment">

    <!-- Top Toolbar (Fixed) -->
    <RelativeLayout
        android:id="@+id/header_transactionDetails"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@color/greenKomyu"
        android:layout_alignParentTop="true">

        <!-- Back button -->
        <ImageView
            android:id="@+id/btn_back_edit_profile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:src="@drawable/back_button_icon2"
            app:tint="@android:color/white"
            android:contentDescription="Back Button" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_edit_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Edit Profile"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_transactionDetails"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Picture Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:layout_marginHorizontal="12dp">

                <ImageButton
                    android:id="@+id/btn_edit_profile_picture"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/add_picture_outline_icon"
                    android:scaleType="centerInside"
                    android:contentDescription="Edit Profile Picture" />

                <TextView
                    android:id="@+id/text_change_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to change profile photo"
                    android:textSize="14sp"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Personal Information Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="12dp"
                android:backgroundTint="@color/whiteKomyu"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:background="@color/whiteKomyu">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="18dp"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/text_personal_info_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERSONAL INFORMATION"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="20dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="First Name"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/edit_first_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:text="Asherah Maye Amancio"
                        android:background="@android:drawable/edit_text"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        android:textSize="18sp"
                        android:layout_marginBottom="8dp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Middle Name"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/edit_middle_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:text="Asherah Maye Amancio"
                        android:background="@android:drawable/edit_text"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        android:textSize="18sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Name"
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        />


                    <EditText
                        android:id="@+id/edit_last_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:text="Asherah Maye Amancio"
                        android:background="@android:drawable/edit_text"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        android:textSize="18sp"
                        android:layout_marginBottom="8dp" />



                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Username"
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/edit_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:text="username"
                        android:background="@android:drawable/edit_text"
                        android:layout_marginBottom="8dp"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Address"
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edit_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:text="asherah.amancio@email.com"
                        android:background="@android:drawable/edit_text"
                        android:layout_marginBottom="8dp"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Number"
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edit_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:text="+63 912 345 6789"
                        android:background="@android:drawable/edit_text"
                        android:layout_marginBottom="8dp"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home Address"
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edit_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPostalAddress"
                        android:text="123 Main Street, City"
                        android:background="@android:drawable/edit_text"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        android:textSize="18sp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Save Button -->
            <Button
                android:id="@+id/btn_save_changes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="Save Changes"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/greenKomyu"
                android:layout_marginBottom="32dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
