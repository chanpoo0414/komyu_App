<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/grey">

    <!-- Green Header -->
    <RelativeLayout
        android:id="@+id/header_transactionDetails"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@color/greenKomyu">

        <!-- Back button -->
        <ImageView
            android:id="@+id/btn_back_transactionDetails"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:src="@drawable/back_button_icon2"
            app:tint="@android:color/white"
            android:contentDescription="Back Button" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_transactionDetails_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Transaction Details"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingVertical="18dp"
        android:paddingHorizontal="12dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_transactionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/whiteKomyu"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginVertical="20dp"
                android:layout_marginHorizontal="30dp">

                <!-- Top: Icon + Title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/icon_transactionDetails"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/logs_icon_circlebg"
                        android:padding="8dp"
                        android:src="@drawable/bus_icon"
                        android:contentDescription="Transaction Icon"/>

                    <TextView
                        android:id="@+id/tv_transactionDetails_mainTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Points Purchase"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@android:color/darker_gray"/>

                <!-- Amount -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Amount:"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_transactionDetails_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:text="-25.00"
                        android:textStyle="bold"
                        android:textColor="@color/RedLogout"/>
                </LinearLayout>

                <!--                <!- Route -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Route:"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_TransactionDetails_route"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sm City -> Sm Seaside"
                        android:textSize="16sp"
                        android:textColor="@color/lightblack2"/>
                </LinearLayout>

                <!-- Driver -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Driver:"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_TransactionDetails_driver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mark Jay"
                        android:textSize="16sp"
                        android:textColor="@color/lightblack2"/>
                </LinearLayout>


                <!-- Conductor -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Conductor:"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_TransactionDetails_conductor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mark Jay"
                        android:textSize="16sp"
                        android:textColor="@color/lightblack2"/>
                </LinearLayout>

                <!-- Counter -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Your Category:"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_transactionDetails_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/lightblack2"
                        android:textSize="16sp"
                        android:text="Regular"/>
                </LinearLayout>

                <!-- Date & Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        android:text="Date &amp; Time:"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_transactionDetails_datetime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/lightblack2"
                        android:textSize="16sp"
                        android:text="Sep 28, 2025 10:31 PM"/>
                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@android:color/darker_gray"/>

                <!-- Transaction Number -->
                <TextView
                    android:id="@+id/tv_transactionDetails_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_gravity="center"
                    android:text="Transaction Number: ASD092352824"
                    android:textSize="12sp"
                    android:layout_marginBottom="20dp"
                    android:textColor="@android:color/darker_gray"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_review_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:padding="20dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/whiteKomyu"
                    app:cardPreventCornerOverlap="true"
                    app:cardUseCompatPadding="true">

                    <!-- Add stroke/border to the card -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_border">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:layout_marginHorizontal="12dp"
                            android:layout_marginVertical="14dp">

                            <TextView
                                android:id="@+id/tv_details"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Help us improve your experience by providing feedback"
                                android:textSize="14sp"
                                android:layout_marginBottom="20dp"
                                android:textColor="@android:color/black"
                                android:gravity="left"/>

                            <!-- Custom RatingBar with proper spacing -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="horizontal"
                                android:paddingBottom="20dp">

                                <!-- Custom star 1 -->
                                <ImageView
                                    android:id="@+id/star1"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/star_outline_icon"
                                    android:layout_marginEnd="8dp"
                                    android:contentDescription="Star 1"/>

                                <!-- Custom star 2 -->
                                <ImageView
                                    android:id="@+id/star2"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/star_outline_icon"
                                    android:layout_marginEnd="8dp"
                                    android:contentDescription="Star 2"/>

                                <!-- Custom star 3 -->
                                <ImageView
                                    android:id="@+id/star3"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/star_outline_icon"
                                    android:layout_marginEnd="8dp"
                                    android:contentDescription="Star 3"/>

                                <!-- Custom star 4 -->
                                <ImageView
                                    android:id="@+id/star4"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/star_outline_icon"
                                    android:layout_marginEnd="8dp"
                                    android:contentDescription="Star 4"/>

                                <!-- Custom star 5 -->
                                <ImageView
                                    android:id="@+id/star5"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/star_outline_icon"
                                    android:contentDescription="Star 5"/>

                            </LinearLayout>
                        </LinearLayout>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </ScrollView>
</LinearLayout>