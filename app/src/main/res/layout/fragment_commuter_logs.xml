<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grey">

    <!-- Green Header (Fixed, Not Scrollable, Not Refreshable) -->
    <LinearLayout
        android:id="@+id/header_commuterLogs"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@color/greenKomyu"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_logs_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transaction History"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Refreshable + Scrollable Section (Grey Background for Logs) -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh_commuterLogs"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/container_commuterLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Date -->
                <TextView
                    android:id="@+id/tv_logs_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="As of Sep 28, 2025"
                    android:textSize="14sp"
                    android:textColor="@android:color/darker_gray"
                    android:paddingBottom="16dp"/>

                <!-- Today Section -->
                <TextView
                    android:id="@+id/tv_logs_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:paddingBottom="8dp"/>

                <!-- Example: Trip Transaction Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_transaction_trip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/white"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <!-- yourIconHere -->
                        <ImageView
                            android:id="@+id/icon_transaction_trip"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/bus_icon"
                            android:background="@drawable/logs_icon_circlebg"
                            android:scaleType="centerCrop"
                            android:padding="6dp"
                            android:contentDescription="Trip Icon"/>

                        <!-- Transaction Info -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:id="@+id/tv_transaction_trip_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Trip to Sm City"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/black"/>

                        </LinearLayout>

                        <!-- Deduction -->
                        <TextView
                            android:id="@+id/tv_transaction_trip_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-25.00"
                            android:textColor="@android:color/holo_red_dark"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Example: Points Purchase Transaction Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_transaction_points"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/white"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <!-- yourIconHere -->
                        <ImageView
                            android:id="@+id/icon_transaction_points"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/plus_points_icon"
                            android:background="@drawable/logs_icon_circlebg"
                            android:scaleType="centerCrop"
                            android:padding="6dp"
                            android:contentDescription="Trip Icon"/>

                        <!-- Transaction Info -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:id="@+id/tv_transaction_points_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Points Purchase"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/black"/>

                        </LinearLayout>

                        <!-- Addition -->
                        <TextView
                            android:id="@+id/tv_transaction_points_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+50.00"
                            android:textColor="@android:color/holo_green_dark"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Yesterday Section -->
                <TextView
                    android:id="@+id/tv_logs_yesterday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yesterday"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"/>

                <!-- yourIconHere example for Yesterday -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_transaction_yesterday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/white"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <!-- yourIconHere -->
                        <ImageView
                            android:id="@+id/icon_transaction_yesterday"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/bus_icon"
                            android:background="@drawable/logs_icon_circlebg"
                            android:scaleType="centerCrop"
                            android:padding="6dp"
                            android:contentDescription="Yesterday Icon"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:id="@+id/tv_transaction_yesterday_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Trip to Ayala"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/black"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_transaction_yesterday_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-20.00"
                            android:textColor="@android:color/holo_red_dark"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Past Date Section -->
                <TextView
                    android:id="@+id/tv_logs_past"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sep 26, 2025"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"/>

                <!-- yourIconHere example for Past -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_transaction_past"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/white"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <!-- yourIconHere -->
                        <ImageView
                            android:id="@+id/icon_transaction_past"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/plus_points_icon"
                            android:background="@drawable/logs_icon_circlebg"
                            android:scaleType="centerCrop"
                            android:padding="6dp"
                            android:contentDescription="Past Icon"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:id="@+id/tv_transaction_past_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Points Purchase"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/black"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_transaction_past_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+100.00"
                            android:textColor="@android:color/holo_green_dark"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>