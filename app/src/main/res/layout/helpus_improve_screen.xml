<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tvHelpTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Help Us Improve"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="12dp"/>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvHelpSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rate your trip and share your experience."
            android:gravity="center"
            android:textColor="@android:color/darker_gray"
            android:paddingBottom="24dp"/>

        <!-- RatingBar -->
        <RatingBar
            android:id="@+id/ratingBar"
            style="?android:attr/ratingBarStyleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:numStars="5"
            android:stepSize="1"
            android:isIndicator="false"
            android:rating="0"
            android:paddingBottom="20dp"/>

        <!-- Positive Feedback Options -->
        <LinearLayout
            android:id="@+id/layoutPositiveFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What did you like?"
                android:textStyle="bold"
                android:paddingBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbFriendly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Friendly &amp; Respectful" />

            <CheckBox
                android:id="@+id/cbSafeDriving"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safe Driving" />

            <CheckBox
                android:id="@+id/cbCleanVehicle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clean Vehicle" />

            <CheckBox
                android:id="@+id/cbHelpful"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Helpful Conductor" />

            <CheckBox
                android:id="@+id/cbOnTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="On-Time Trip" />
        </LinearLayout>

        <!-- Negative Feedback Options -->
        <LinearLayout
            android:id="@+id/layoutNegativeFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What problems did you experience?"
                android:textStyle="bold"
                android:paddingBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbRudeDriver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rude Driver/Conductor" />

            <CheckBox
                android:id="@+id/cbReckless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reckless Driving" />

            <CheckBox
                android:id="@+id/cbOvercharge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overcharging / No Proper Fare" />

            <CheckBox
                android:id="@+id/cbDirty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dirty / Unsafe Vehicle" />

            <CheckBox
                android:id="@+id/cbRoute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Did Not Follow Route" />

            <CheckBox
                android:id="@+id/cbOtherIssue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Other Issue" />
        </LinearLayout>

        <!-- Comment Box -->
        <EditText
            android:id="@+id/etComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Write your feedback (optional)"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:layout_marginBottom="24dp"/>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit Review" />
    </LinearLayout>
</ScrollView>
