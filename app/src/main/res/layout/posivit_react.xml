<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Trip Details -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trip Details"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tvBus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bus: #1234 (Route A - B)"/>

        <TextView
            android:id="@+id/tvDriver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Driver: Juan Dela Cruz"/>

        <TextView
            android:id="@+id/tvConductor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conductor: Pedro Santos"/>

        <TextView
            android:id="@+id/tvTripDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sept 30, 2025 • 08:30 AM"
            android:paddingBottom="16dp"/>

        <!-- Report Target -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Who is this feedback about?"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/rbDriver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Driver"/>
            <RadioButton
                android:id="@+id/rbConductor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conductor"/>
            <RadioButton
                android:id="@+id/rbBoth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Driver &amp; Conductor"/>
        </RadioGroup>

        <!-- Positive Feedback Options -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What did you like?"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"/>

        <CheckBox
            android:id="@+id/cbFriendly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Friendly &amp; Respectful"/>

        <CheckBox
            android:id="@+id/cbSafeDriving"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safe Driving"/>

        <CheckBox
            android:id="@+id/cbCleanVehicle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clean Vehicle"/>

        <CheckBox
            android:id="@+id/cbHelpful"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Helpful Conductor"/>

        <CheckBox
            android:id="@+id/cbOnTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On-Time Trip"/>

        <!-- Comment -->
        <EditText
            android:id="@+id/etGoodComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Write additional feedback (optional)"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:layout_marginTop="16dp"/>

        <!-- Submit -->
        <Button
            android:id="@+id/btnSubmitGood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit Review"
            android:layout_marginTop="20dp"/>
    </LinearLayout>
</ScrollView>
