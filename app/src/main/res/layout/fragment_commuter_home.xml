<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey">

    <!-- Fixed Header -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/greenKomyu"
        android:theme="@style/AppBarLightTheme"
        style="@style/FixedAppBarStyle"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/imgProfileIcon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/profile_bg_white"
                    android:padding="8dp"
                    android:src="@drawable/username_icon" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asherah Maye Amancio"
                        android:textColor="@color/whiteKomyu"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStudentId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="000-044-02"
                        android:textColor="@color/whiteKomyu"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvUserRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student"
                        android:textColor="@color/whiteKomyu"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Wallet + Top Up buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <!-- Wallet = selected -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_wallet"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/white"
                    android:text="Wallet"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    app:cornerRadius="50dp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content" />

                <!-- Top Up = inactive -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_topup"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/greenKomyu"
                    android:text="Top Up"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:strokeColor="@color/white"
                    app:strokeWidth="1dp"
                    app:cornerRadius="50dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- SwipeRefreshLayout wrapping the scrollable content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Scrollable Body -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="16dp"
            android:backgroundTint="@color/bgGrey">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:dividerPadding="8dp">

                <!-- Wallet Balance Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:padding="16dp"
                    app:cardCornerRadius="18dp"
                    android:backgroundTint="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_wallet_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current points"
                            android:layout_marginTop="16dp"
                            android:textColor="@android:color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_gravity="center" />

                        <TextView
                            android:id="@+id/tv_wallet_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="45.50"
                            android:textColor="@android:color/black"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:layout_gravity="center"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_buy_load"
                            android:layout_width="300dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginBottom="18dp"
                            android:backgroundTint="@color/lightGreenKomyu"
                            android:textColor="@color/whiteKomyu"
                            android:text="Buy Points"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- Quick Actions + Travel Overview (Second Card) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:padding="16dp"
                    app:cardCornerRadius="18dp"
                    android:backgroundTint="@color/white"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >

                        <!-- Quick Actions Title -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quick Actions"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@android:color/black"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="12dp" />

                        <!-- Quick Actions Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginHorizontal="16dp">

                            <!-- Scan & Pay -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_scan_pay"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                app:cardCornerRadius="12dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="@color/lightblack"
                                android:backgroundTint="@color/white"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:padding="12dp">

                                    <ImageView
                                        android:layout_width="34dp"
                                        android:layout_height="34dp"
                                        android:padding="6dp"
                                        android:src="@drawable/qr_outline_icon"
                                        android:background="@drawable/qr_scanner_bg"
                                        android:scaleType="centerCrop"
                                        android:contentDescription="@string/app_name" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:text="Scan &amp; Pay"
                                        android:textStyle="bold"
                                        android:textSize="14sp"
                                        android:textColor="@android:color/black" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Terminals -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_terminals"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                app:cardCornerRadius="12dp"
                                app:strokeColor="@color/lightblack"
                                android:backgroundTint="@color/white"
                                app:strokeWidth="1dp"
                                android:background="@color/white"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:padding="12dp">

                                    <ImageView
                                        android:layout_width="34dp"
                                        android:layout_height="34dp"
                                        android:src="@drawable/location_outline_icon"
                                        android:background="@drawable/location_bg"
                                        android:scaleType="centerCrop"
                                        android:padding="6dp"
                                        android:contentDescription="@string/app_name" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:text="View Terminals"
                                        android:textStyle="bold"
                                        android:textSize="14sp"
                                        android:textColor="@android:color/black" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <!-- Travel Overview Title -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Travel Overview"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@android:color/black"
                            android:layout_marginTop="20dp"
                            android:layout_marginLeft="16dp"
                            android:layout_marginBottom="12dp" />

                        <!-- Travel Overview Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginBottom="24dp">

                            <!-- Total Points Spent -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                app:cardCornerRadius="12dp"
                                app:strokeColor="@color/lightblack"
                                android:backgroundTint="@color/white"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:padding="12dp">

                                    <ImageView
                                        android:layout_width="34dp"
                                        android:layout_height="34dp"
                                        android:padding="6dp"
                                        android:background="@drawable/card_and_location_bg_grey"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/card_outline"
                                        android:contentDescription="@string/app_name" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tv_total_points_value"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="98.00"
                                            android:textStyle="bold"
                                            android:textSize="14sp"
                                            android:textColor="@android:color/black" />
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="Total Points Spent"
                                            android:textSize="9sp"
                                            android:textColor="@android:color/black" />
                                    </LinearLayout>

                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Trips This Week -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                app:cardCornerRadius="12dp"
                                app:strokeColor="@color/lightblack"
                                android:backgroundTint="@color/white"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:padding="12dp">

                                    <ImageView
                                        android:layout_width="34dp"
                                        android:layout_height="34dp"
                                        android:padding="6dp"
                                        android:background="@drawable/card_and_location_bg_grey"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/clock_outline_icon"
                                        android:contentDescription="@string/app_name" />
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tv_trip_count_value"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="8"
                                            android:textStyle="bold"
                                            android:textSize="14sp"
                                            android:textColor="@android:color/black" />
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="Trips this week"
                                            android:textSize="10sp"
                                            android:textColor="@android:color/black" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>


                <!-- Recent Activity Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="4dp"
                    android:backgroundTint="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginHorizontal="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="18dp"
                            android:layout_marginHorizontal="12dp">

                            <TextView
                                android:layout_width="267dp"
                                android:layout_height="wrap_content"
                                android:text="Recent Activity"
                                android:textColor="@android:color/black"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_see_all"
                                android:layout_width="80dp"
                                android:layout_height="match_parent"
                                android:text="See all"
                                android:textColor="@color/greenKomyu"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycler_recent_activity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:listitem="@layout/item_recent_activity" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>